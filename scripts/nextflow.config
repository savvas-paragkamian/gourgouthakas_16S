// Run configuration for the Gourgouthakas cave HiFi 16S dataset.
//
// The pipeline runs from INSIDE the gourgouthakas-16s container (see
// Containerfile and scripts/run_pipeline.sh),
// so neither conda nor per-process containers are used: every tool is already
// on PATH in the image, pinned to the versions in HiFi-16S-workflow/env/*.yml.
// This avoids nested containerisation and any network access at run time.
//
//   ./scripts/run_pipeline.sh

params {
    enable_conda     = false
    enable_container = true
}

// enable_container above only satisfies base.config's docker/singularity
// blocks; both engines are then explicitly switched off so processes execute
// natively inside this container.
docker.enabled      = false
singularity.enabled = false
podman.enabled      = false

// The pipeline's dada2/cutadapt/seqkit/csvtk env is deliberately kept off the
// image's default PATH so the downstream analysis keeps the system R
// (dada2 1.40.0). Task execution gets the pinned 1.38.0 env prepended here.
env {
    PATH   = "/opt/conda/envs/hifi16s/bin:${System.getenv('PATH')}"
    TMPDIR = './tmp/'
}

// Host has 16 cores / 31 GB. base.config's defaults — and especially the
// highcpu (64 cpus) and highmem (500 GB) labels — exceed that, and Nextflow
// would refuse to schedule those tasks, so all requests are capped to fit.
process {
    resourceLimits = [ cpus: 14, memory: 26.GB, time: 24.h ]

    // Retry only on the exit codes that indicate resource exhaustion; a real
    // pipeline error should stop the run rather than be retried twice.
    errorStrategy = { task.exitStatus in [104, 134, 137, 138, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
}

executor {
    name      = 'local'
    cpus      = 14
    memory    = 26.GB
    queueSize = 8
}

workDir = 'work'
